rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ai đăng nhập cũng đọc được hồ sơ user (để search + hiện tên/avatar).
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    match /chats/{chatId} {
      // chatId = sort(uidA, uidB).join("_") -> 2 thành viên nằm ngay trong id.
      // Xác thực bằng id thay vì resource.data: hoạt động kể cả khi doc chưa
      // tồn tại (mở phòng chat mới) -> không bị permission-denied giả.
      function isMember() {
        return request.auth != null && request.auth.uid in chatId.split('_');
      }
      // participants phải đúng 2 thành viên suy từ chatId -> chống giả mạo
      // metadata (chèn/đổi participants, bơm unreadCount của người khác...).
      // hasOnly không phụ thuộc thứ tự nên sendMessage của cả 2 phía đều hợp lệ;
      // markAsRead dùng merge không đụng participants nên vẫn giữ đủ 2 thành viên.
      function validParticipants() {
        return request.resource.data.participants is list
            && request.resource.data.participants.size() == 2
            && request.resource.data.participants.hasOnly(chatId.split('_'));
      }

      // get 1 doc (mở phòng): xác thực bằng chatId -> không vỡ khi doc chưa tồn tại.
      allow get: if isMember();
      // list (query inbox: where participants arrayContains uid): phải dựa trên
      // resource.data.participants để Firestore xác thực được tập kết quả của query.
      allow list: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      // Tạo/sửa metadata: phải là thành viên và participants hợp lệ.
      allow create, update: if isMember() && validParticipants();

      match /messages/{messageId} {
        allow read: if isMember();
        // Người gửi phải là chính mình VÀ là thành viên của cuộc chat.
        allow create: if isMember()
            && request.auth.uid == request.resource.data.senderId;
      }
    }
  }
}
